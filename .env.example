# Build-time. Restart `npm run dev` after changing.
# Backend base URL used by live islands (TargetsGrid), compile/export
# calls, and the agent relay (POST /agent/turn).
#
# No provider or key settings exist here on purpose: the backend owns
# model routing and holds every API key. There is nothing to configure
# for the agent.
PUBLIC_API_URL=http://localhost:8000
