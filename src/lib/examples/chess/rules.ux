( chess rules: board, move generation, check, mate, AI helpers.
  Squares 0-63 (rank*8+file, rank 0 = white home). Pieces 0 empty,
  1-6 white P N B R Q K, 7-12 black. No recursion anywhere (static
  locals); make/unmake share undo globals; legality filters by
  simulation. Promotion is always queen; draws by stalemate or the
  50-move clock (no repetition tracking). )

import "pieces.ux"

buffer board[64]: u8;
turn: u8 = 0;
castling: u8 = 0;
ep_sq: u8 = 64;
half_clock: u8 = 0;

buffer mfrom[128]: u8;
buffer mto[128]: u8;
moven: u8 = 0;

u_from: u8 = 0;
u_to: u8 = 0;
u_cap: u8 = 0;
u_cast: u8 = 0;
u_ep: u8 = 0;
u_clock: u8 = 0;
u_promo: u8 = 0;
u_epcap: u8 = 0;

ai_f: u8 = 0;
ai_t: u8 = 0;
seed: u8 = 1;

CAST_WK :: 1;
CAST_WQ :: 2;
CAST_BK :: 4;
CAST_BQ :: 8;

ST_PLAY :: 0;
ST_MATE :: 1;
ST_DRAW :: 2;

side_of :: fn(p: u8) -> u8 {
    if p == 0 {
        return 2;
    }
    if p < 7 {
        return 0;
    }
    return 1;
}

kind_of :: fn(p: u8) -> u8 {
    if p < 7 {
        return p - 1;
    }
    return p - 7;
}

add_move :: fn(f: u8, t: u8) {
    if moven < 128 {
        mfrom[moven] = f;
        mto[moven] = t;
        moven = moven + 1;
    }
}

( One ray step; fs/rs are 1 (forward) or 255 (backward, wraps to
  >7 which the bound check catches). )
ray :: fn(sq: u8, side: u8, fs: u8, rs: u8) {
    f: u8 = sq - sq / 8 * 8;
    r: u8 = sq / 8;
    f2: u8 = f + fs;
    r2: u8 = r + rs;
    blocked: u8 = 0;
    while blocked == 0 {
        if f2 > 7 {
            blocked = 1;
        }
        if r2 > 7 {
            blocked = 1;
        }
        if blocked == 0 {
            t: u8 = r2 * 8 + f2;
            q: u8 = board[t];
            if q == 0 {
                add_move(sq, t);
            } else {
                if side_of(q) != side {
                    add_move(sq, t);
                }
                blocked = 1;
            }
            f2 = f2 + fs;
            r2 = r2 + rs;
        }
    }
}

( One leaper landing; df/dr biased like ray steps. )
leap_to :: fn(sq: u8, f: u8, r: u8, side: u8, df: u8, dr: u8) {
    nf: u8 = f + df;
    nr: u8 = r + dr;
    if nf > 7 {
        return;
    }
    if nr > 7 {
        return;
    }
    t: u8 = nr * 8 + nf;
    q: u8 = board[t];
    if q == 0 {
        add_move(sq, t);
        return;
    }
    if side_of(q) != side {
        add_move(sq, t);
    }
}

gen_pawn :: fn(sq: u8, f: u8, r: u8, side: u8) {
    if side == 0 {
        if r != 7 {
            if board[sq + 8] == 0 {
                add_move(sq, sq + 8);
                if r == 1 {
                    if board[sq + 16] == 0 {
                        add_move(sq, sq + 16);
                    }
                }
            }
            if f != 0 {
                t: u8 = sq + 7;
                q: u8 = board[t];
                if q != 0 {
                    if side_of(q) == 1 {
                        add_move(sq, t);
                    }
                } else {
                    if t == ep_sq {
                        add_move(sq, t);
                    }
                }
            }
            if f != 7 {
                t: u8 = sq + 9;
                q: u8 = board[t];
                if q != 0 {
                    if side_of(q) == 1 {
                        add_move(sq, t);
                    }
                } else {
                    if t == ep_sq {
                        add_move(sq, t);
                    }
                }
            }
        }
    } else {
        if r != 0 {
            if board[sq - 8] == 0 {
                add_move(sq, sq - 8);
                if r == 6 {
                    if board[sq - 16] == 0 {
                        add_move(sq, sq - 16);
                    }
                }
            }
            if f != 0 {
                t: u8 = sq - 9;
                q: u8 = board[t];
                if q != 0 {
                    if side_of(q) == 0 {
                        add_move(sq, t);
                    }
                } else {
                    if t == ep_sq {
                        add_move(sq, t);
                    }
                }
            }
            if f != 7 {
                t: u8 = sq - 7;
                q: u8 = board[t];
                if q != 0 {
                    if side_of(q) == 0 {
                        add_move(sq, t);
                    }
                } else {
                    if t == ep_sq {
                        add_move(sq, t);
                    }
                }
            }
        }
    }
}

gen_knight :: fn(sq: u8, f: u8, r: u8, side: u8) {
    leap_to(sq, f, r, side, 1, 2);
    leap_to(sq, f, r, side, 2, 1);
    leap_to(sq, f, r, side, 2, 255);
    leap_to(sq, f, r, side, 1, 254);
    leap_to(sq, f, r, side, 255, 254);
    leap_to(sq, f, r, side, 254, 255);
    leap_to(sq, f, r, side, 254, 1);
    leap_to(sq, f, r, side, 255, 2);
}

gen_king :: fn(sq: u8, f: u8, r: u8, side: u8) {
    leap_to(sq, f, r, side, 0, 1);
    leap_to(sq, f, r, side, 1, 1);
    leap_to(sq, f, r, side, 1, 0);
    leap_to(sq, f, r, side, 1, 255);
    leap_to(sq, f, r, side, 0, 255);
    leap_to(sq, f, r, side, 255, 255);
    leap_to(sq, f, r, side, 255, 0);
    leap_to(sq, f, r, side, 255, 1);
    if side == 0 {
        if sq == 4 {
            if castling & CAST_WK != 0 {
                if board[5] == 0 {
                    if board[6] == 0 {
                        if attacked(4, 1) == 0 {
                            if attacked(5, 1) == 0 {
                                if attacked(6, 1) == 0 {
                                    add_move(4, 6);
                                }
                            }
                        }
                    }
                }
            }
            if castling & CAST_WQ != 0 {
                if board[3] == 0 {
                    if board[2] == 0 {
                        if board[1] == 0 {
                            if attacked(4, 1) == 0 {
                                if attacked(3, 1) == 0 {
                                    if attacked(2, 1) == 0 {
                                        add_move(4, 2);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        if sq == 60 {
            if castling & CAST_BK != 0 {
                if board[61] == 0 {
                    if board[62] == 0 {
                        if attacked(60, 0) == 0 {
                            if attacked(61, 0) == 0 {
                                if attacked(62, 0) == 0 {
                                    add_move(60, 62);
                                }
                            }
                        }
                    }
                }
            }
            if castling & CAST_BQ != 0 {
                if board[59] == 0 {
                    if board[58] == 0 {
                        if board[57] == 0 {
                            if attacked(60, 0) == 0 {
                                if attacked(59, 0) == 0 {
                                    if attacked(58, 0) == 0 {
                                        add_move(60, 58);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

gen_moves :: fn(side: u8) {
    moven = 0;
    sq: u8 = 0;
    while sq < 64 {
        p: u8 = board[sq];
        if p != 0 {
            if side_of(p) == side {
                f: u8 = sq - sq / 8 * 8;
                r: u8 = sq / 8;
                k: u8 = kind_of(p);
                if k == 0 {
                    gen_pawn(sq, f, r, side);
                }
                if k == 1 {
                    gen_knight(sq, f, r, side);
                }
                if k == 2 {
                    ray(sq, side, 1, 1);
                    ray(sq, side, 1, 255);
                    ray(sq, side, 255, 1);
                    ray(sq, side, 255, 255);
                }
                if k == 3 {
                    ray(sq, side, 1, 0);
                    ray(sq, side, 255, 0);
                    ray(sq, side, 0, 1);
                    ray(sq, side, 0, 255);
                }
                if k == 4 {
                    ray(sq, side, 1, 1);
                    ray(sq, side, 1, 255);
                    ray(sq, side, 255, 1);
                    ray(sq, side, 255, 255);
                    ray(sq, side, 1, 0);
                    ray(sq, side, 255, 0);
                    ray(sq, side, 0, 1);
                    ray(sq, side, 0, 255);
                }
                if k == 5 {
                    gen_king(sq, f, r, side);
                }
            }
        }
        sq = sq + 1;
    }
}

( Is sq attacked by side `by` (0 white, 1 black)? )
attacked :: fn(sq: u8, by: u8) -> u8 {
    f: u8 = sq - sq / 8 * 8;
    r: u8 = sq / 8;
    if by == 0 {
        if r != 0 {
            if f != 0 {
                if board[sq - 9] == 1 {
                    return 1;
                }
            }
            if f != 7 {
                if board[sq - 7] == 1 {
                    return 1;
                }
            }
        }
    } else {
        if r != 7 {
            if f != 0 {
                if board[sq + 7] == 7 {
                    return 1;
                }
            }
            if f != 7 {
                if board[sq + 9] == 7 {
                    return 1;
                }
            }
        }
    }
    if knight_hits(sq, f, r, by) != 0 {
        return 1;
    }
    if king_hits(sq, f, r, by) != 0 {
        return 1;
    }
    if ray_hit(sq, 1, 1, by, 1) != 0 {
        return 1;
    }
    if ray_hit(sq, 1, 255, by, 1) != 0 {
        return 1;
    }
    if ray_hit(sq, 255, 1, by, 1) != 0 {
        return 1;
    }
    if ray_hit(sq, 255, 255, by, 1) != 0 {
        return 1;
    }
    if ray_hit(sq, 1, 0, by, 0) != 0 {
        return 1;
    }
    if ray_hit(sq, 255, 0, by, 0) != 0 {
        return 1;
    }
    if ray_hit(sq, 0, 1, by, 0) != 0 {
        return 1;
    }
    if ray_hit(sq, 0, 255, by, 0) != 0 {
        return 1;
    }
    return 0;
}

knight_hits :: fn(sq: u8, f: u8, r: u8, by: u8) -> u8 {
    want: u8 = 2;
    if by == 1 {
        want = 8;
    }
    if leap_has(sq, f, r, 1, 2, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 2, 1, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 2, 255, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 1, 254, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 255, 254, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 254, 255, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 254, 1, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 255, 2, want) != 0 {
        return 1;
    }
    return 0;
}

leap_has :: fn(sq: u8, f: u8, r: u8, df: u8, dr: u8, want: u8) -> u8 {
    nf: u8 = f + df;
    nr: u8 = r + dr;
    if nf > 7 {
        return 0;
    }
    if nr > 7 {
        return 0;
    }
    if board[nr * 8 + nf] == want {
        return 1;
    }
    return 0;
}

king_hits :: fn(sq: u8, f: u8, r: u8, by: u8) -> u8 {
    want: u8 = 6;
    if by == 1 {
        want = 12;
    }
    if leap_has(sq, f, r, 0, 1, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 1, 1, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 1, 0, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 1, 255, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 0, 255, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 255, 255, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 255, 0, want) != 0 {
        return 1;
    }
    if leap_has(sq, f, r, 255, 1, want) != 0 {
        return 1;
    }
    return 0;
}

( First piece along the ray: 1 when it belongs to `by` and
  slides along it (diag 1: bishops and queens; straight 0: rooks
  and queens). )
ray_hit :: fn(sq: u8, fs: u8, rs: u8, by: u8, diag: u8) -> u8 {
    f: u8 = sq - sq / 8 * 8;
    r: u8 = sq / 8;
    f2: u8 = f + fs;
    r2: u8 = r + rs;
    blocked: u8 = 0;
    hit: u8 = 0;
    while blocked == 0 {
        if f2 > 7 {
            blocked = 1;
        }
        if r2 > 7 {
            blocked = 1;
        }
        if blocked == 0 {
            q: u8 = board[r2 * 8 + f2];
            if q != 0 {
                if side_of(q) == by {
                    k: u8 = kind_of(q);
                    if k == 4 {
                        hit = 1;
                    }
                    if diag == 1 {
                        if k == 2 {
                            hit = 1;
                        }
                    } else {
                        if k == 3 {
                            hit = 1;
                        }
                    }
                }
                blocked = 1;
            }
            f2 = f2 + fs;
            r2 = r2 + rs;
        }
    }
    return hit;
}

find_king :: fn(side: u8) -> u8 {
    want: u8 = 6;
    if side == 1 {
        want = 12;
    }
    sq: u8 = 0;
    while sq < 64 {
        if board[sq] == want {
            return sq;
        }
        sq = sq + 1;
    }
    return 0;
}

in_check :: fn(side: u8) -> u8 {
    if side == 0 {
        return attacked(find_king(0), 1);
    }
    return attacked(find_king(1), 0);
}

( Apply f->t (castling rook hop, en-passant capture, auto-queen
  promotion included), recording everything undo needs. Flips turn. )
do_move :: fn(f: u8, t: u8) {
    p: u8 = board[f];
    k: u8 = kind_of(p);
    side: u8 = side_of(p);
    u_from = f;
    u_to = t;
    u_cap = board[t];
    u_cast = castling;
    u_ep = ep_sq;
    u_clock = half_clock;
    u_promo = 0;
    u_epcap = 0;
    old_ep: u8 = ep_sq;
    ep_sq = 64;
    half_clock = half_clock + 1;
    if k == 0 {
        half_clock = 0;
        ff: u8 = f - f / 8 * 8;
        tt: u8 = t - t / 8 * 8;
        if side == 0 {
            if t == f + 16 {
                ep_sq = f + 8;
            }
            ( en-passant only on a diagonal step onto old_ep )
            if t == old_ep {
                if ff != tt {
                    u_cap = board[t - 8];
                    board[t - 8] = 0;
                    u_epcap = 1;
                }
            }
            if t / 8 == 7 {
                board[f] = 5;
                u_promo = 1;
            }
        } else {
            if t + 16 == f {
                ep_sq = f - 8;
            }
            if t == old_ep {
                ff: u8 = f - f / 8 * 8;
                tt: u8 = t - t / 8 * 8;
                if ff != tt {
                    u_cap = board[t + 8];
                    board[t + 8] = 0;
                    u_epcap = 1;
                }
            }
            if t / 8 == 0 {
                board[f] = 11;
                u_promo = 1;
            }
        }
    }
    if u_cap != 0 {
        half_clock = 0;
    }
    ( castling: king hops two )
    if k == 5 {
        if side == 0 {
            if f == 4 {
                if t == 6 {
                    board[5] = board[7];
                    board[7] = 0;
                }
                if t == 2 {
                    board[3] = board[0];
                    board[0] = 0;
                }
            }
            if castling & CAST_WK != 0 {
                castling = castling - CAST_WK;
            }
            if castling & CAST_WQ != 0 {
                castling = castling - CAST_WQ;
            }
        } else {
            if f == 60 {
                if t == 62 {
                    board[61] = board[63];
                    board[63] = 0;
                }
                if t == 58 {
                    board[59] = board[56];
                    board[56] = 0;
                }
            }
            if castling & CAST_BK != 0 {
                castling = castling - CAST_BK;
            }
            if castling & CAST_BQ != 0 {
                castling = castling - CAST_BQ;
            }
        }
    }
    ( rook moves or captures on corner squares drop rights )
    if f == 0 {
        if castling & CAST_WQ != 0 {
            castling = castling - CAST_WQ;
        }
    }
    if f == 7 {
        if castling & CAST_WK != 0 {
            castling = castling - CAST_WK;
        }
    }
    if f == 56 {
        if castling & CAST_BQ != 0 {
            castling = castling - CAST_BQ;
        }
    }
    if f == 63 {
        if castling & CAST_BK != 0 {
            castling = castling - CAST_BK;
        }
    }
    if t == 0 {
        if castling & CAST_WQ != 0 {
            castling = castling - CAST_WQ;
        }
    }
    if t == 7 {
        if castling & CAST_WK != 0 {
            castling = castling - CAST_WK;
        }
    }
    if t == 56 {
        if castling & CAST_BQ != 0 {
            castling = castling - CAST_BQ;
        }
    }
    if t == 63 {
        if castling & CAST_BK != 0 {
            castling = castling - CAST_BK;
        }
    }
    board[t] = board[f];
    board[f] = 0;
    if turn == 0 {
        turn = 1;
    } else {
        turn = 0;
    }
}

undo_move :: fn() {
    f: u8 = u_from;
    t: u8 = u_to;
    ( undo the castling rook hop first )
    p: u8 = board[t];
    if kind_of(p) == 5 {
        if f == 4 {
            if t == 6 {
                board[7] = board[5];
                board[5] = 0;
            }
            if t == 2 {
                board[0] = board[3];
                board[3] = 0;
            }
        }
        if f == 60 {
            if t == 62 {
                board[63] = board[61];
                board[61] = 0;
            }
            if t == 58 {
                board[56] = board[59];
                board[59] = 0;
            }
        }
    }
    ( restore the mover: a promoted queen becomes a pawn again )
    if u_promo != 0 {
        if side_of(p) == 0 {
            board[f] = 1;
        } else {
            board[f] = 7;
        }
    } else {
        board[f] = p;
    }
    board[t] = 0;
    ( restore captures: only an en-passant capture took from beside
      the target square; normal captures sat on it. )
    if u_cap != 0 {
        if u_epcap != 0 {
            if side_of(p) == 0 {
                board[t - 8] = u_cap;
            } else {
                board[t + 8] = u_cap;
            }
            board[t] = 0;
        } else {
            board[t] = u_cap;
        }
    }
    castling = u_cast;
    ep_sq = u_ep;
    half_clock = u_clock;
    if turn == 0 {
        turn = 1;
    } else {
        turn = 0;
    }
}

( All legal moves for side (pseudo + king-safety filter). )
gen_legal :: fn(side: u8) {
    gen_moves(side);
    keep: u8 = 0;
    total: u8 = moven;
    r: u8 = 0;
    while r < 128 {
        if r < total {
            f: u8 = mfrom[r];
            t: u8 = mto[r];
            do_move(f, t);
            if in_check(side) == 0 {
                mfrom[keep] = f;
                mto[keep] = t;
                keep = keep + 1;
            }
            undo_move();
        }
        r = r + 1;
    }
    moven = keep;
}

( 0 ongoing, 1 checkmate (side mated), 2 stalemate/draw. )
game_status :: fn(side: u8) -> u8 {
    gen_legal(side);
    if moven != 0 {
        return ST_PLAY;
    }
    if in_check(side) != 0 {
        return ST_MATE;
    }
    return ST_DRAW;
}

( Standard array; white pawns rank 1, back rank 0. )
setup_board :: fn() {
    i: u8 = 0;
    while i < 64 {
        board[i] = 0;
        i = i + 1;
    }
    board[0] = 4;
    board[1] = 2;
    board[2] = 3;
    board[3] = 5;
    board[4] = 6;
    board[5] = 3;
    board[6] = 2;
    board[7] = 4;
    board[56] = 10;
    board[57] = 8;
    board[58] = 9;
    board[59] = 11;
    board[60] = 12;
    board[61] = 9;
    board[62] = 8;
    board[63] = 10;
    i: u8 = 0;
    while i < 8 {
        board[8 + i] = 1;
        board[48 + i] = 7;
        i = i + 1;
    }
    turn = 0;
    castling = 15;
    ep_sq = 64;
    half_clock = 0;
}

( Greedy 1-ply: captures by value, checks, mates, dice. Probing
  (game_status) trashes the move list and undo slots, so candidates
  live in aff/att copies and the undo bytes are stashed per probe. )
piece_value :: fn(k: u8) -> u16 {
    if k == 0 {
        return 10;
    }
    if k == 1 {
        return 30;
    }
    if k == 2 {
        return 30;
    }
    if k == 3 {
        return 50;
    }
    if k == 4 {
        return 90;
    }
    return 0;
}

buffer aifrom[128]: u8;
buffer aito[128]: u8;

( AI probe stash lives in RAM (zero-page is budgeted elsewhere). )
buffer sustate[8]: u8;

ai_choose :: fn(side: u8) {
    gen_legal(side);
    total: u8 = moven;
    c: u8 = 0;
    while c < 128 {
        if c < total {
            aifrom[c] = mfrom[c];
            aito[c] = mto[c];
        }
        c = c + 1;
    }
    best: u16 = 0;
    ai_f = aifrom[0];
    ai_t = aito[0];
    foe: u8 = 1;
    if side == 1 {
        foe = 0;
    }
    r: u8 = 0;
    while r < 128 {
        if r < total {
            f: u8 = aifrom[r];
            t: u8 = aito[r];
            cap: u8 = board[t];
            score: u16 = rand8();
            if cap != 0 {
                score = score + piece_value(kind_of(cap)) * 10;
            }
            ( en-passant capture scores a pawn )
            if cap == 0 {
                pf: u8 = board[f];
                if kind_of(pf) == 0 {
                    ff: u8 = f - f / 8 * 8;
                    tt: u8 = t - t / 8 * 8;
                    if ff != tt {
                        score = score + 100;
                    }
                }
            }
            do_move(f, t);
            sustate[0] = u_from;
            sustate[1] = u_to;
            sustate[2] = u_cap;
            sustate[3] = u_cast;
            sustate[4] = u_ep;
            sustate[5] = u_clock;
            sustate[6] = u_promo;
            sustate[7] = u_epcap;
            saved_n: u8 = moven;
            st: u8 = game_status(foe);
            if st == ST_MATE {
                score = score + 10000;
            } else {
                if in_check(foe) != 0 {
                    score = score + 50;
                }
            }
            u_from = sustate[0];
            u_to = sustate[1];
            u_cap = sustate[2];
            u_cast = sustate[3];
            u_ep = sustate[4];
            u_clock = sustate[5];
            u_promo = sustate[6];
            u_epcap = sustate[7];
            moven = saved_n;
            undo_move();
            if score > best {
                best = score;
                ai_f = f;
                ai_t = t;
            }
        }
        r = r + 1;
    }
}

rand8 :: fn() -> u8 {
    seed = seed * 251 + 31;
    return seed % 8;
}

