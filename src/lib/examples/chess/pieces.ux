( chess pieces: 6 shapes x 2bpp x 8px, white + black sets.
  Authored as 8-row silhouettes, then dilated one pixel for the
  outline ring: white = light fill (1) + dark outline (3), black =
  dark fill (3) + light outline (1). 12 tiles x 16 bytes = 192B.
  Drawn with SPRITE_2BPP; flip vertically for the far side. )

PT_PAWN :: 0;
PT_KNIGHT :: 1;
PT_BISHOP :: 2;
PT_ROOK :: 3;
PT_QUEEN :: 4;
PT_KING :: 5;

( Piece codes on the board: 0 empty, 1-6 white P N B R Q K,
  7-12 black. )
PC_EMPTY :: 0;

( ROM address of a side/kind tile (kind 0-5, side 0 white). )
tile_addr :: fn(kind: u8, side: u8) -> u16 {
    if side == 0 {
        return &wtiles + kind * 16;
    }
    return &btiles + kind * 16;
}

data wtiles = [
    0x3C, 0x7E, 0x7E, 0x7E, 0xFF, 0xFF, 0xFF, 0xFF,
    0x24, 0x66, 0x42, 0x66, 0xC3, 0x81, 0x81, 0x00,
    0x7E, 0x7F, 0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x62, 0x43, 0x49, 0xC1, 0x83, 0x83, 0x81, 0x00,
    0x7E, 0x7E, 0x7E, 0x7E, 0xFF, 0xFF, 0xFF, 0xFF,
    0x66, 0x42, 0x5A, 0x66, 0xC3, 0x81, 0x81, 0x00,
    0xFF, 0xFF, 0xFF, 0x3C, 0x3C, 0x7E, 0xFF, 0xFF,
    0x99, 0x81, 0xE7, 0x24, 0x24, 0x66, 0xC3, 0x00,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x99, 0x99, 0x81, 0xE7, 0xC3, 0x81, 0x81, 0x00,
    0x3C, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x24, 0xE7, 0x81, 0xE7, 0xC3, 0x81, 0x81, 0x00,
];
data btiles = [
    0x3C, 0x7E, 0x7E, 0x7E, 0xFF, 0xFF, 0xFF, 0xFF,
    0x18, 0x18, 0x3C, 0x18, 0x3C, 0x7E, 0x7E, 0xFF,
    0x7E, 0x7F, 0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x1C, 0x3C, 0x36, 0x3E, 0x7C, 0x7C, 0x7E, 0xFF,
    0x7E, 0x7E, 0x7E, 0x7E, 0xFF, 0xFF, 0xFF, 0xFF,
    0x18, 0x3C, 0x24, 0x18, 0x3C, 0x7E, 0x7E, 0xFF,
    0xFF, 0xFF, 0xFF, 0x3C, 0x3C, 0x7E, 0xFF, 0xFF,
    0x66, 0x7E, 0x18, 0x18, 0x18, 0x18, 0x3C, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x66, 0x66, 0x7E, 0x18, 0x3C, 0x7E, 0x7E, 0xFF,
    0x3C, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0x18, 0x18, 0x7E, 0x18, 0x3C, 0x7E, 0x7E, 0xFF,
];
