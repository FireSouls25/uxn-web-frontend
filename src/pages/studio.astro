---
import Base from "../layouts/Base.astro";
import RequireAuth from "../components/RequireAuth";
import StudioHeader from "../components/StudioHeader";
import StudioCenter from "../components/StudioCenter";
---

<Base titleKey="page.studio" title="Studio">
  <!-- client:only: these islands read localStorage-backed stores, so
    server HTML (default sample project) would mismatch the client
    on hydration. Skipping SSR avoids the React mismatch recovery. -->
  <RequireAuth client:only="react">
    <div class="flex h-[calc(100vh-3.5rem)] flex-col overflow-hidden bg-base">
      <div class="shrink-0">
        <StudioHeader client:only="react" />
      </div>

      <div class="relative min-h-0 flex-1">
        <StudioCenter client:only="react" />
      </div>
    </div>
  </RequireAuth>
</Base>
