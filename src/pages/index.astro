---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero";
import Reveal from "../components/Reveal";
import TargetsGrid from "../components/TargetsGrid";
import { Boxes, Braces, Gamepad2, Rocket } from "lucide-react";

const FEATURES = [
  { icon: Boxes, tint: "text-mauve", key: "1", title: "Scene editor", body: "Hierarchy, canvas viewport and inspector — the dockable workstation from the reference, rebuilt in Catppuccin." },
  { icon: Braces, tint: "text-teal", key: "2", title: "Visual event graph", body: "on_click, on_hold, drag and key bindings as nodes. They lower to ETAL vectors, never black boxes." },
  { icon: Gamepad2, tint: "text-green", key: "3", title: "Sprite studio", body: "Pixel canvases and animation rails that export .chr tiles the compiler embeds with zero conversion." },
  { icon: Rocket, tint: "text-peach", key: "4", title: "One-click export", body: "The backend assembles via drifblim and wraps your ROM: native bundles or a self-contained web page." },
] as const;
---

<Base title="Low-code games for Uxn">
  <Hero client:load />

  <section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-16">
    <Reveal>
      <p class="font-mono text-[11px] uppercase tracking-widest text-mauve" data-i18n="feat.kicker">[01 / workstation]</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl" data-i18n="feat.title">
        An editor that speaks machine
      </h2>
    </Reveal>
    <div class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        FEATURES.map((f, i) => (
          <Reveal delay={i * 0.07}>
            <div class="pane group h-full rounded-xl p-5 transition-colors hover:border-surface1">
              <f.icon size={20} className={f.tint} />
              <h3 class="mt-3 text-[15px] font-semibold" data-i18n={`feat.${f.key}t`}>{f.title}</h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-subtext0" data-i18n={`feat.${f.key}b`}>{f.body}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section id="targets" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-20">
    <Reveal>
      <p class="font-mono text-[11px] uppercase tracking-widest text-mauve" data-i18n="tgt.kicker">[02 / export]</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl" data-i18n="tgt.title">
        Select target deployment engine
      </h2>
      <p class="mt-2 max-w-xl text-sm text-subtext0" data-i18n="tgt.sub">
        The ROM is portable — only the VM half varies. One Linux backend wraps every row.
      </p>
    </Reveal>
    <div class="mt-7">
      <TargetsGrid client:visible />
    </div>
  </section>

  <section class="border-t border-surface0 bg-mantle">
    <Reveal className="mx-auto max-w-6xl px-4 py-14 text-center">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl" data-i18n="cta.title">Ship your first ROM tonight</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-subtext0" data-i18n="cta.sub">
        Sign up, open the studio, and export for Linux and web in minutes.
      </p>
      <a
        href="/register"
        data-i18n="cta.btn"
        class="mt-6 inline-block rounded-lg bg-mauve px-6 py-2.5 text-sm font-semibold text-crust"
      >
        Create free account
      </a>
    </Reveal>
  </section>
</Base>
