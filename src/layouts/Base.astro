---
import SiteHeader from "../components/SiteHeader";
import "../styles/theme.css";

interface Props {
  titleKey: string;
  title: string;
  description?: string;
}

const { titleKey, title, description = "Low-code games for the Uxn virtual machine." } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title data-title-key={titleKey}>{title} · uxn·forge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        // Theme: stored choice wins ("auto" = follow the OS, the default).
        var savedTheme = localStorage.getItem("uxn.theme") || "auto";
        var eff =
          savedTheme === "latte" || savedTheme === "mocha"
            ? savedTheme
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "latte"
              : "mocha";
        document.documentElement.dataset.theme = eff;
      } catch (e) {
        /* private mode — mocha default stands */
      }
      try {
        const savedLang = localStorage.getItem("uxn.lang");
        document.documentElement.dataset.lang =
          savedLang === "es" || savedLang === "en"
            ? savedLang
            : (navigator.language || "en").toLowerCase().startsWith("es")
              ? "es"
              : "en";
      } catch {
        /* private mode — English fallback stands */
      }
    </script>
  </head>
  <body class="min-h-screen">
    <SiteHeader client:load />
    <main>
      <slot />
    </main>
  </body>
</html>
    <script>
      import { applyStaticLang, detectLang, t } from "../lib/i18n";
      const lang = detectLang();
      document.documentElement.dataset.lang = lang;
      function applyAll(l: Parameters<typeof applyStaticLang>[0]) {
        applyStaticLang(l);
        const key = document.querySelector("title[data-title-key]")?.getAttribute("data-title-key");
        if (key) document.title = `${t(l, key)} · uxn·forge`;
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => applyAll(lang));
      } else {
        applyAll(lang);
      }
      window.addEventListener("uxn:lang", (e) =>
        applyAll((e as CustomEvent).detail ?? detectLang()),
      );
    </script>
  </body>
</html>
